   "source": [
    "# Define the complete model architecture\n",
    "model = Sequential()\n",
    "\n",
    "# 1. Text Vectorization Layer (replaces Tokenizer + pad_sequences)\n",
    "model.add(TextVectorization(\n",
    "    max_tokens=num_words,               # Vocabulary size (same as input_dim in Embedding)\n",
    "    output_sequence_length=max_len,    # Same as input_length in Embedding\n",
    "    output_mode='int',             # Output integer indices\n",
    "    name='text_vectorization'\n",
    "))                                 # Input shape: (batch_size,) of strings\n",
    "\n",
    "# 2. Embedding Layer (convert tokens to vectors)\n",
    "model.add(Embedding(\n",
    "    input_dim=num_words,                # vocab_size + 1 (3000 words + OOV/padding)\n",
    "    output_dim=64,                # Same as your example\n",
    "    input_length=max_len,              # Must match output_sequence_length\n",
    "    mask_zero=True,                # Ignore padding tokens\n",
    "    name='embedding'\n",
    "))\n",
    "\n",
    "# 3. LSTM Layer (sequence processing)\n",
    "model.add(LSTM(\n",
    "    units=64,                     # Same as your example\n",
    "    dropout=0.2,                   # Regularization\n",
    "    recurrent_dropout=0.2,         # Recurrent regularization\n",
    "    name='lstm'\n",
    "))\n",
    "\n",
    "# 4. Hidden Dense Layer (additional processing power)\n",
    "model.add(Dense(\n",
    "    units=32,                      # Intermediate representation\n",
    "    activation='relu',             # Non-linearity\n",
    "    name='dense_intermediate'\n",
    "))\n",
    "\n",
    "# 5. Output Layer (binary classification)\n",
    "model.add(Dense(\n",
    "    units=1,                       # Single output neuron\n",
    "    activation='sigmoid',          # Probability output\n",
    "    name='output'\n",
    "))\n",
    "\n",
    "# Compile the model (add this after creating the vectorizer)\n",
    "model.compile(\n",
    "    loss='binary_crossentropy',\n",
    "    optimizer='adam',\n",
    "    metrics=['accuracy']\n",
    ")\n",
    "\n",
    "# Adapt the vectorizer to your data (REQUIRED before training)\n",
    "# x_train should be a list/array of raw text strings\n",
    "model.get_layer('text_vectorization').adapt(x_train)\n",
    "\n",
    "# Model summary\n",
    "model.summary()"
