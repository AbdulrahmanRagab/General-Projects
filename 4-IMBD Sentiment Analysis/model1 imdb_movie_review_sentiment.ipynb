    "def clean_text(text):\n",
    "    \"\"\"\n",
    "    Clean and preprocess text using spaCy\n",
    "    \"\"\"\n",
    "    # Convert to string if not already\n",
    "    text = str(text)\n",
    "\n",
    "    # Remove URLs and emails\n",
    "    text = re.sub(r'http\\S+|www\\S+|https\\S+|\\S+@\\S+', '', text)\n",
    "\n",
    "    # Remove special characters (keep only letters)\n",
    "    text = re.sub(r'[^a-zA-Z\\s]', '', text)\n",
    "\n",
    "    # Remove extra whitespace\n",
    "    text = re.sub(r'\\s+', ' ', text).strip()\n",
    "\n",
    "    # Process with spaCy\n",
    "    doc = nlp(text)\n",
    "\n",
    "    cleaned_tokens = []\n",
    "    for token in doc:\n",
    "        # Skip punctuation, stop words, numbers, spaces, and short tokens\n",
    "        if (token.is_punct or token.is_stop or\n",
    "            token.like_num or token.is_space or\n",
    "            len(token.text) < 2):\n",
    "            continue\n",
    "\n",
    "        # Lemmatize and lowercase\n",
    "        cleaned_tokens.append(token.lemma_.lower())\n",
    "\n",
    "    return ' '.join(cleaned_tokens)"
   ]
